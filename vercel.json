{
  "rewrites": [
    {
      "source": "/webcraft.apk",
      "destination": "/WebCraft.apk"
    }
  ],
  "headers": [
    {
      "source": "/WebCraft.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"WebCraft.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"WebCraft.apk\""
        }
      ]
    }
  ]
}
